---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { reader } from '../../lib/reader';
import { mediaUrl } from '../../lib/assets';

const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
const postsRaw = await reader.collections.posts.all({ resolveLinkedFiles: true });
const posts = postsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .sort((a, b) => String(b.publishDate ?? '').localeCompare(String(a.publishDate ?? '')));
---

<BaseLayout title={`Stories — ${site.siteName}`}>
  <Header site={site} />
  <main class="border-b border-brand-900/[0.06] bg-sand-50 pb-24">
    <div class="border-b border-brand-900/[0.06] bg-white py-16 sm:py-20">
      <div class="container-site max-w-4xl">
        <p class="eyebrow">{site.blogPageEyebrow ?? "Stories & updates"}</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{site.blogPageTitle ?? "From the field"}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-950/75">
          {site.blogPageIntro ?? "Long-form updates, participant voice, and partnership notes — published through the same CMS as the rest of the site."}
        </p>
      </div>
    </div>
    <div class="container-site section-y !pt-16">
      <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => {
            const img = mediaUrl(post.coverImage ?? undefined);
            return (
              <li>
                <a href={`/blog/${post.slug}`} class="group card card-hover block !p-0">
                  <div class="aspect-[16/10] overflow-hidden rounded-t-xl bg-sand-200">
                    {img ? (
                      <img
                        src={img}
                        alt={post.coverImageAlt ?? `${post.title} cover image`}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-gradient-to-br from-brand-900/85 to-teal-700/80 text-[13px] font-medium text-white/90">
                        {site.blogCardPlaceholderText ?? "Story"}
                      </div>
                    )}
                  </div>
                  <div class="p-7">
                    <time class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted" datetime={String(post.publishDate)}>
                      {post.publishDate}
                    </time>
                    <h2 class="mt-3 font-display text-lg font-semibold leading-snug text-brand-950 group-hover:text-brand-800">
                      {post.title}
                    </h2>
                    <p class="mt-2 line-clamp-3 text-[14px] leading-relaxed text-brand-950/70">{post.excerpt}</p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </main>
  <Footer site={site} />
</BaseLayout>
