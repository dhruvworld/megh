---
import { mediaUrl } from '../lib/assets';

interface Site {
  siteName: string;
  donateUrl: string;
  logo?: string | null;
  logoAlt?: string | null;
  headerNav?: Array<{ label: string; href: string }>;
  headerPartnerLabel?: string;
  headerDonateLabel?: string;
}

interface Props {
  site: Site;
}

const { site } = Astro.props;
const logoSrc = mediaUrl(site.logo ?? undefined);

const nav =
  site.headerNav && site.headerNav.length > 0
    ? site.headerNav
    : [
        { href: '/programs', label: 'What we do' },
        { href: '/about', label: 'Who we are' },
        { href: '/blog', label: 'Stories' },
        { href: '/contact', label: 'Get in touch' },
      ];
---

<header class="sticky top-0 z-50 border-b border-brand-900/[0.07] bg-sand-50/80 backdrop-blur-xl supports-[backdrop-filter]:bg-sand-50/70">
  <div class="container-site flex items-center justify-between gap-4 py-4 lg:py-5">
    <a href="/" class="group flex min-w-0 items-center gap-3 outline-none ring-brand-900/20 focus-visible:ring-2">
      {
        logoSrc ? (
          <img src={logoSrc} alt={site.logoAlt ?? site.siteName} class="h-9 w-auto shrink-0 sm:h-10" width="140" height="40" />
        ) : (
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-brand-900 text-xs font-bold tracking-tight text-white shadow-inner shadow-black/10 sm:h-10 sm:w-10 sm:text-sm"
            aria-hidden="true"
          >
            MF
          </span>
        )
      }
      <span class="truncate font-display text-lg font-semibold tracking-tight text-brand-950 sm:text-xl">
        {site.siteName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="relative px-3 py-2 text-[15px] font-medium text-brand-950/80 transition after:absolute after:inset-x-3 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-brand-800 after:transition after:content-[''] hover:text-brand-950 hover:after:scale-x-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        import.meta.env.DEV && (
          <a href="/keystatic" class="btn-ghost hidden text-sm text-muted xl:inline-flex">
            CMS
          </a>
        )
      }
      <a href="/contact" class="btn-ghost hidden text-[15px] sm:inline-flex">
        {site.headerPartnerLabel ?? 'Partner'}
      </a>
      <a href={site.donateUrl} class="btn-primary px-5 py-2.5 text-sm sm:px-7 sm:py-3 sm:text-[15px]">
        {site.headerDonateLabel ?? 'Donate'}
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center justify-center rounded-md border border-brand-900/10 bg-white p-2.5 text-brand-950 shadow-sm marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-[min(100vw-2.5rem,18rem)] rounded-xl border border-brand-900/10 bg-white py-2 shadow-xl"
          role="navigation"
        >
          {
            nav.map((item) => (
              <a href={item.href} class="block px-4 py-3 text-[15px] font-medium text-brand-950 hover:bg-sand-50">
                {item.label}
              </a>
            ))
          }
          <div class="my-2 border-t border-brand-900/8" />
          <a href="/contact" class="block px-4 py-3 text-[15px] font-medium text-brand-950 hover:bg-sand-50">
            {site.headerPartnerLabel ?? 'Partner'}
          </a>
          <a href={site.donateUrl} class="block px-4 py-3 text-[15px] font-semibold text-accent hover:bg-sand-50">
            {site.headerDonateLabel ?? 'Donate'}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
