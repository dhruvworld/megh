---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { reader } from '../../lib/reader';
import { mediaUrl, optimizedImageSrc, optimizedImageSrcSet } from '../../lib/assets';

const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
const programsRaw = await reader.collections.programs.all({ resolveLinkedFiles: true });
const programs = programsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout title={`Programs — ${site.siteName}`}>
  <Header site={site} />
  <main class="border-b border-brand-900/[0.06] bg-sand-50 pb-24">
    <div class="border-b border-brand-900/[0.06] bg-white py-16 sm:py-20">
      <div class="container-site max-w-4xl">
        <p class="eyebrow">{site.programsPageEyebrow ?? "What we do"}</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{site.programsPageTitle ?? "Programmes"}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-950/75">
          {site.programsPageIntro ?? "Each programme combines narrative, photography, and evidence — the standard international NGOs use to explain thematic work to donors and communities."}
        </p>
      </div>
    </div>
    <div class="container-site section-y !pt-16">
      <ul class="grid gap-10 md:grid-cols-2">
        {
          programs.map((prog) => {
            const cover = mediaUrl(prog.coverImage ?? undefined);
            return (
              <li>
                <a href={`/programs/${prog.slug}`} class="group card card-hover block overflow-hidden !p-0">
                  <div class="aspect-[21/9] bg-sand-200">
                    {cover ? (
                      <img
                        src={optimizedImageSrc(cover, 960)}
                        srcset={optimizedImageSrcSet(cover, [560, 760, 980, 1200])}
                        sizes="(max-width: 768px) 94vw, 48vw"
                        alt={prog.coverImageAlt ?? `${prog.title} cover photo`}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-900 to-teal-700 text-[13px] font-medium text-white/90">
                        {site.programsNoImageText ?? "Add cover image"}
                      </div>
                    )}
                  </div>
                  <div class="p-8">
                    <h2 class="font-display text-xl font-semibold text-brand-950 group-hover:text-brand-800">{prog.title}</h2>
                    <p class="mt-3 text-[15px] leading-relaxed text-brand-950/72">{prog.summary}</p>
                    <span class="link-inline mt-5 inline-block text-[14px]">{site.programsCardCtaText ?? "Programme brief"}</span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </main>
  <Footer site={site} />
</BaseLayout>
