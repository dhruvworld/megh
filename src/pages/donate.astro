---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { reader } from '../lib/reader';

const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
const phoneDigits = (site.phone ?? '').replace(/\D/g, '');
const callHref = phoneDigits ? `tel:+${phoneDigits}` : null;
const whatsappHref = phoneDigits ? `https://wa.me/${phoneDigits}` : null;
const mailHref = site.email ? `mailto:${site.email}` : null;
---

<BaseLayout title={`${site.donateDirectLabel ?? "Donate"} — ${site.siteName}`}>
  <Header site={site} />
  <main class="border-b border-brand-900/[0.06] bg-sand-50 pb-24">
    <div class="border-b border-brand-900/[0.06] bg-gradient-to-b from-brand-900 to-brand-800 py-20 text-center text-white sm:py-24">
      <div class="container-site max-w-3xl">
        <p class="eyebrow text-teal-200/90">{site.donatePageEyebrow ?? "Ways to give"}</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{site.donatePageTitle ?? "Support our work"}</h1>
        <p class="mt-6 text-lg leading-relaxed text-white/85">{site.donateIntro}</p>
      </div>
    </div>
    <div class="container-site -mt-10 max-w-2xl text-center">
      <div class="card !p-10 shadow-xl">
        <div class="flex flex-wrap justify-center gap-3">
          <button type="button" class="btn-primary" data-open-donate-modal>
            {site.donateDirectLabel ?? "Donate"}
          </button>
          <a href={`mailto:${site.email}?subject=Donation`} class="btn-secondary">{site.donateDiscussLabel ?? "Discuss a grant"}</a>
        </div>
        <p class="mt-8 text-[13px] leading-relaxed text-muted">
          {site.donateHelperText ?? "Point the donate URL in the CMS to Razorpay, GiveIndia, or your bank instructions page when ready."}
        </p>
      </div>
    </div>

    <div
      id="donate-page-modal"
      class="fixed inset-0 z-[80] hidden items-center justify-center bg-brand-950/55 px-4"
      aria-hidden="true"
    >
      <div class="w-full max-w-sm rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Donate support</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-brand-950">Choose contact method</h3>
          </div>
          <button type="button" class="rounded-md p-2 text-brand-900/70 hover:bg-sand-100" data-close-donate-modal aria-label="Close donate popup">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="mt-5 grid gap-2.5">
          {callHref && (
            <a href={callHref} class="btn-secondary justify-start !px-4 !py-3">
              Call
            </a>
          )}
          {whatsappHref && (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-secondary justify-start !px-4 !py-3">
              WhatsApp
            </a>
          )}
          {mailHref && (
            <a href={mailHref} class="btn-secondary justify-start !px-4 !py-3">
              Mail
            </a>
          )}
          {!callHref && !whatsappHref && !mailHref && (
            <a href={site.donateUrl} class="btn-primary justify-center !px-4 !py-3">
              Continue to donate
            </a>
          )}
        </div>
      </div>
    </div>
  </main>
  <Footer site={site} />
</BaseLayout>

<script>
  const modal = document.getElementById('donate-page-modal');
  const openButtons = document.querySelectorAll('[data-open-donate-modal]');
  const closeButtons = document.querySelectorAll('[data-close-donate-modal]');

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  };

  const openModal = () => {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  };

  openButtons.forEach((button) =>
    button.addEventListener('click', (event) => {
      event.preventDefault();
      openModal();
    })
  );

  closeButtons.forEach((button) => button.addEventListener('click', closeModal));
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeModal();
  });
</script>
