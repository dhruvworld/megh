---
const registerUrl = 'https://forms.gle/34KBhmw82PEtqPKMA';
const popupImage = '/site/event-popup-2026.jpg';
---

<div
  id="event-popup"
  class="event-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="event-popup-title"
  hidden
>
  <div class="event-popup__backdrop" data-popup-close></div>
  <div class="event-popup__panel">
    <p id="event-popup-title" class="sr-only">
      Toppers Honor and Career Guidance Program 2026 — registration announcement
    </p>
    <div class="event-popup__image-wrap">
      <img
        src={popupImage}
        alt="Toppers Honor and Career Guidance Program 2026 — register by 13 June 2026"
        width="800"
        height="1200"
        class="event-popup__image"
        loading="eager"
        decoding="async"
      />
      <button
        type="button"
        class="event-popup__close-hit"
        data-popup-close
        aria-label="Close announcement"
      ></button>
      <a
        href={registerUrl}
        class="event-popup__register"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Register now — opens Google Form in a new tab"
      >
        <span class="sr-only">Register now</span>
      </a>
    </div>
  </div>
</div>

<script>
  const popup = document.getElementById('event-popup');
  if (popup) {
    const show = () => {
      popup.hidden = false;
      document.body.classList.add('event-popup-open');
    };

    const hide = () => {
      popup.hidden = true;
      document.body.classList.remove('event-popup-open');
    };

    popup.querySelectorAll('[data-popup-close]').forEach((el) => {
      el.addEventListener('click', hide);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.hidden) hide();
    });

    show();
  }
</script>

<style>
  .event-popup {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
  }

  .event-popup[hidden] {
    display: none;
  }

  .event-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 31, 77, 0.72);
    backdrop-filter: blur(4px);
  }

  .event-popup__panel {
    position: relative;
    z-index: 1;
    width: min(92vw, 400px);
    max-height: min(94vh, 820px);
    animation: event-popup-in 0.35s ease-out;
  }

  @keyframes event-popup-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .event-popup__image-wrap {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(15, 23, 42, 0.45);
    line-height: 0;
  }

  .event-popup__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(92vh, 780px);
    object-fit: contain;
  }

  /* Built-in X at top-right of the flyer */
  .event-popup__close-hit {
    position: absolute;
    top: 1.2%;
    right: 2.5%;
    width: 9%;
    height: 4.8%;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
    transition: background 0.15s;
  }

  .event-popup__close-hit:hover,
  .event-popup__close-hit:focus-visible {
    background: rgba(255, 255, 255, 0.18);
    outline: none;
  }

  /* REGISTER NOW button (blue capsule) */
  .event-popup__register {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 54.5%;
    height: 7.5%;
    border-radius: 9999px;
    cursor: pointer;
    transition: outline 0.15s, background 0.15s;
  }

  .event-popup__register:hover,
  .event-popup__register:focus-visible {
    outline: 3px solid rgba(255, 215, 0, 0.85);
    outline-offset: 2px;
    background: rgba(255, 255, 255, 0.1);
  }

  :global(body.event-popup-open) {
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
