---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { reader } from '../lib/reader';

const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
---

<BaseLayout title={`{site.contactPageTitle ?? "Contact"} — ${site.siteName}`}>
  <Header site={site} />
  <main class="border-b border-brand-900/[0.06] bg-sand-50 pb-20">
    <div class="border-b border-brand-900/[0.06] bg-white py-16 sm:py-20">
      <div class="container-site max-w-4xl">
        <p class="eyebrow">{site.contactPageEyebrow ?? "Get in touch"}</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{site.contactPageTitle ?? "Contact"}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-950/75">{site.contactIntro}</p>
      </div>
    </div>
    <div class="container-site section-y !pt-16">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
        <div class="card !space-y-8 !p-8">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">Phone</p>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="mt-2 block font-display text-2xl font-semibold text-brand-950 hover:text-brand-800">
              {site.phone}
            </a>
          </div>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">Email</p>
            <a href={`mailto:${site.email}`} class="mt-2 block break-all text-lg font-semibold text-brand-950 hover:text-brand-800">
              {site.email}
            </a>
          </div>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">Address</p>
            <p class="mt-2 whitespace-pre-line text-[15px] leading-relaxed text-brand-950/78">{site.address}</p>
          </div>
        </div>
        <div class="card border-t-4 border-t-teal-500 !p-8">
          <h2 class="font-display text-2xl font-semibold">{site.contactPartnershipTitle ?? "CSR & partnerships"}</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">
            {site.contactPartnershipBody ?? "Share geography, sector, and CSR goals. We reply with a tailored proposal, indicative budget, and delivery timeline."}
          </p>
          <ul class="mt-5 space-y-2 text-[14px] text-brand-950/75">
            <li>• {site.contactPartnershipBullet1 ?? "First response within 2 business days"}</li>
            <li>• {site.contactPartnershipBullet2 ?? "Initial concept note within 7 business days"}</li>
            <li>• {site.contactPartnershipBullet3 ?? "Budget and implementation milestones included"}</li>
          </ul>
          <a href={`mailto:${site.email}?subject=CSR%20partnership`} class="btn-primary mt-8 inline-flex w-full justify-center sm:w-auto">
            {site.contactPartnershipButtonLabel ?? "Email partnerships"}
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer site={site} />
</BaseLayout>
