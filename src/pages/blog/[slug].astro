---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { reader } from '../../lib/reader';
import { mediaUrl } from '../../lib/assets';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const all = await reader.collections.posts.all({ resolveLinkedFiles: true });
  return all.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
const post = slug ? await reader.collections.posts.read(slug, { resolveLinkedFiles: true }) : null;
if (!post) {
  return Astro.redirect('/blog');
}

const cover = mediaUrl(post.coverImage ?? undefined);
const html = renderMarkdown(post.bodyMarkdown ?? '');
---

<BaseLayout title={`${post.title} — ${site.siteName}`} description={post.excerpt}>
  <Header site={site} />
  <article class="border-b border-brand-900/[0.06] bg-sand-50 pb-24">
    <header class="border-b border-brand-900/[0.06] bg-white py-12 sm:py-16">
      <div class="container-site max-w-3xl">
        <a href="/blog" class="text-[14px] font-semibold text-brand-800 hover:text-brand-950">← {site.blogDetailBackLabel ?? "All stories"}</a>
        <time class="mt-5 block text-[11px] font-semibold uppercase tracking-[0.2em] text-muted" datetime={String(post.publishDate)}>
          {post.publishDate}
        </time>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-[2.75rem]">{post.title}</h1>
        <p class="mt-5 text-xl leading-relaxed text-brand-950/75">{post.excerpt}</p>
      </div>
    </header>
    <div class="container-site max-w-3xl pt-12 sm:pt-16">
      {
        cover && (
          <div class="overflow-hidden rounded-2xl border border-brand-900/[0.08] shadow-lg">
            <img src={cover} alt={post.coverImageAlt ?? `${post.title} cover image`} class="w-full object-cover" loading="eager" />
          </div>
        )
      }
      <div class={`prose-cms ${cover ? 'mt-14' : ''} border-t border-brand-900/[0.06] pt-14`} set:html={html} />
    </div>
  </article>
  <Footer site={site} />
</BaseLayout>
