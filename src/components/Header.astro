---
import { mediaUrl } from '../lib/assets';

interface Site {
  siteName: string;
  donateUrl: string;
  phone?: string;
  email?: string;
  logo?: string | null;
  logoAlt?: string | null;
  headerNav?: Array<{ label: string; href: string }>;
  headerPartnerLabel?: string;
  headerVolunteerLabel?: string;
  volunteerPageHref?: string;
  headerDonateLabel?: string;
}

interface Props {
  site: Site;
}

const { site } = Astro.props;
const logoSrc = mediaUrl(site.logo ?? undefined);
const volunteerHref = site.volunteerPageHref ?? '/contact';
const phoneDigits = (site.phone ?? '').replace(/\D/g, '');
const callHref = phoneDigits ? `tel:+${phoneDigits}` : null;
const whatsappHref = phoneDigits ? `https://wa.me/${phoneDigits}` : null;
const mailHref = site.email ? `mailto:${site.email}` : null;

const nav =
  site.headerNav && site.headerNav.length > 0
    ? site.headerNav
    : [
        { href: '/programs', label: 'What we do' },
        { href: '/about', label: 'Who we are' },
        { href: '/blog', label: 'Stories' },
        { href: '/contact', label: 'Get in touch' },
      ];
---

<header class="sticky top-0 z-50 border-b border-brand-900/[0.07] bg-sand-50/80 backdrop-blur-xl supports-[backdrop-filter]:bg-sand-50/70">
  <div class="container-site flex items-center justify-between gap-4 py-4 lg:py-5">
    <a href="/" class="group flex min-w-0 items-center gap-3 outline-none ring-brand-900/20 focus-visible:ring-2">
      {
        logoSrc ? (
          <img src={logoSrc} alt={site.logoAlt ?? site.siteName} class="h-14 w-auto shrink-0 sm:h-16 lg:h-20" width="260" height="80" />
        ) : (
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-md bg-brand-900 text-base font-bold tracking-tight text-white shadow-inner shadow-black/10 sm:h-16 sm:w-16 sm:text-lg lg:h-20 lg:w-20"
            aria-hidden="true"
          >
            MF
          </span>
        )
      }
      <span class="truncate font-display text-lg font-semibold tracking-tight text-brand-950 sm:text-xl">
        {site.siteName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="relative px-3 py-2 text-[15px] font-medium text-brand-950/80 transition after:absolute after:inset-x-3 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-brand-800 after:transition after:content-[''] hover:text-brand-950 hover:after:scale-x-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        import.meta.env.DEV && (
          <a href="/keystatic" class="btn-ghost hidden text-sm text-muted xl:inline-flex">
            CMS
          </a>
        )
      }
      <a href="/contact" class="btn-ghost hidden text-[15px] sm:inline-flex">
        {site.headerPartnerLabel ?? 'Partner'}
      </a>
      <button type="button" class="btn-ghost hidden text-[15px] md:inline-flex" data-open-volunteer-modal>
        {site.headerVolunteerLabel ?? 'Volunteer With Us'}
      </button>
      <button type="button" class="btn-primary px-5 py-2.5 text-sm sm:px-7 sm:py-3 sm:text-[15px]" data-open-donate-modal>
        {site.headerDonateLabel ?? 'Donate'}
      </button>

      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center justify-center rounded-md border border-brand-900/10 bg-white p-2.5 text-brand-950 shadow-sm marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-[min(100vw-2.5rem,18rem)] rounded-xl border border-brand-900/10 bg-white py-2 shadow-xl"
          role="navigation"
        >
          {
            nav.map((item) => (
              <a href={item.href} class="block px-4 py-3 text-[15px] font-medium text-brand-950 hover:bg-sand-50">
                {item.label}
              </a>
            ))
          }
          <div class="my-2 border-t border-brand-900/8" />
          <a href="/contact" class="block px-4 py-3 text-[15px] font-medium text-brand-950 hover:bg-sand-50">
            {site.headerPartnerLabel ?? 'Partner'}
          </a>
          <button type="button" class="block w-full px-4 py-3 text-left text-[15px] font-medium text-brand-950 hover:bg-sand-50" data-open-volunteer-modal>
            {site.headerVolunteerLabel ?? 'Volunteer With Us'}
          </button>
          <button type="button" class="block w-full px-4 py-3 text-left text-[15px] font-semibold text-accent hover:bg-sand-50" data-open-donate-modal>
            {site.headerDonateLabel ?? 'Donate'}
          </button>
        </div>
      </details>
    </div>
  </div>
</header>

<div
  id="donate-modal"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-brand-950/55 px-4"
  aria-hidden="true"
>
  <div class="w-full max-w-sm rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Donate support</p>
        <h3 class="mt-2 font-display text-xl font-semibold text-brand-950">Choose contact method</h3>
      </div>
      <button type="button" class="rounded-md p-2 text-brand-900/70 hover:bg-sand-100" data-close-donate-modal aria-label="Close donate popup">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="mt-5 grid gap-2.5">
      {callHref && (
        <a href={callHref} class="btn-secondary justify-start !px-4 !py-3">
          Call
        </a>
      )}
      {whatsappHref && (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-secondary justify-start !px-4 !py-3">
          WhatsApp
        </a>
      )}
      {mailHref && (
        <a href={mailHref} class="btn-secondary justify-start !px-4 !py-3">
          Mail
        </a>
      )}
      {!callHref && !whatsappHref && !mailHref && (
        <a href={site.donateUrl} class="btn-primary justify-center !px-4 !py-3">
          Continue to donate
        </a>
      )}
    </div>
  </div>
</div>

<div
  id="volunteer-modal"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-brand-950/55 px-4"
  aria-hidden="true"
>
  <div class="w-full max-w-sm rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Volunteer support</p>
        <h3 class="mt-2 font-display text-xl font-semibold text-brand-950">Choose contact method</h3>
      </div>
      <button type="button" class="rounded-md p-2 text-brand-900/70 hover:bg-sand-100" data-close-volunteer-modal aria-label="Close volunteer popup">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="mt-5 grid gap-2.5">
      {callHref && (
        <a href={callHref} class="btn-secondary justify-start !px-4 !py-3">
          Call
        </a>
      )}
      {whatsappHref && (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-secondary justify-start !px-4 !py-3">
          WhatsApp
        </a>
      )}
      {mailHref && (
        <a href={mailHref} class="btn-secondary justify-start !px-4 !py-3">
          Mail
        </a>
      )}
      {!callHref && !whatsappHref && !mailHref && (
        <a href={volunteerHref} class="btn-primary justify-center !px-4 !py-3">
          Continue to volunteer
        </a>
      )}
    </div>
  </div>
</div>

<script>
  const donateModal = document.getElementById('donate-modal');
  const volunteerModal = document.getElementById('volunteer-modal');
  const openDonateButtons = document.querySelectorAll('[data-open-donate-modal]');
  const closeDonateButtons = document.querySelectorAll('[data-close-donate-modal]');
  const openVolunteerButtons = document.querySelectorAll('[data-open-volunteer-modal]');
  const closeVolunteerButtons = document.querySelectorAll('[data-close-volunteer-modal]');

  const closeDonateModal = () => {
    if (!donateModal) return;
    donateModal.classList.add('hidden');
    donateModal.classList.remove('flex');
    donateModal.setAttribute('aria-hidden', 'true');
  };

  const openDonateModal = () => {
    if (!donateModal) return;
    donateModal.classList.remove('hidden');
    donateModal.classList.add('flex');
    donateModal.setAttribute('aria-hidden', 'false');
  };

  const closeVolunteerModal = () => {
    if (!volunteerModal) return;
    volunteerModal.classList.add('hidden');
    volunteerModal.classList.remove('flex');
    volunteerModal.setAttribute('aria-hidden', 'true');
  };

  const openVolunteerModal = () => {
    if (!volunteerModal) return;
    volunteerModal.classList.remove('hidden');
    volunteerModal.classList.add('flex');
    volunteerModal.setAttribute('aria-hidden', 'false');
  };

  openDonateButtons.forEach((button) =>
    button.addEventListener('click', (event) => {
      event.preventDefault();
      openDonateModal();
    })
  );

  openVolunteerButtons.forEach((button) =>
    button.addEventListener('click', (event) => {
      event.preventDefault();
      openVolunteerModal();
    })
  );

  closeDonateButtons.forEach((button) => button.addEventListener('click', closeDonateModal));
  closeVolunteerButtons.forEach((button) => button.addEventListener('click', closeVolunteerModal));

  donateModal?.addEventListener('click', (event) => {
    if (event.target === donateModal) closeDonateModal();
  });

  volunteerModal?.addEventListener('click', (event) => {
    if (event.target === volunteerModal) closeVolunteerModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDonateModal();
      closeVolunteerModal();
    }
  });
</script>
