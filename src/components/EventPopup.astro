---
const registerUrl = 'https://forms.gle/34KBhmw82PEtqPKMA';
const popupImage = '/site/event-popup.jpg';
---

<div
  id="event-popup"
  class="event-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="event-popup-title"
  hidden
>
  <div class="event-popup__backdrop" data-popup-close></div>
  <div class="event-popup__panel">
    <button
      type="button"
      class="event-popup__close"
      data-popup-close
      aria-label="Close announcement"
    >
      <span aria-hidden="true">&times;</span>
    </button>
    <p id="event-popup-title" class="sr-only">
      Toppers Honor and Career Guidance Program 2026 — registration announcement
    </p>
    <div class="event-popup__image-wrap">
      <img
        src={popupImage}
        alt="Toppers Honor and Career Guidance Program 2026 — Megh Foundation and Vighnaharta Charitable Trust"
        width="1200"
        height="1200"
        class="event-popup__image"
        loading="eager"
        decoding="async"
      />
      <a
        href={registerUrl}
        class="event-popup__register"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Start registration — opens Google Form in a new tab"
      >
        <span class="sr-only">Start register</span>
      </a>
    </div>
  </div>
</div>

<script>
  const popup = document.getElementById('event-popup');
  if (popup) {
    const show = () => {
      popup.hidden = false;
      document.body.classList.add('event-popup-open');
    };

    const hide = () => {
      popup.hidden = true;
      document.body.classList.remove('event-popup-open');
    };

    popup.querySelectorAll('[data-popup-close]').forEach((el) => {
      el.addEventListener('click', hide);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.hidden) hide();
    });

    show();
  }
</script>

<style>
  .event-popup {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .event-popup[hidden] {
    display: none;
  }

  .event-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 31, 77, 0.72);
    backdrop-filter: blur(4px);
  }

  .event-popup__panel {
    position: relative;
    z-index: 1;
    width: min(92vw, 520px);
    max-height: min(92vh, 720px);
    animation: event-popup-in 0.35s ease-out;
  }

  @keyframes event-popup-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .event-popup__close {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 9999px;
    background: white;
    color: #1847a3;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.2);
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
  }

  .event-popup__close:hover {
    background: #edf4ff;
    transform: scale(1.05);
  }

  .event-popup__image-wrap {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(15, 23, 42, 0.45);
    line-height: 0;
  }

  .event-popup__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(85vh, 680px);
    object-fit: contain;
  }

  /* Clickable overlay aligned to the START REGISTER button on the flyer */
  .event-popup__register {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 11.5%;
    height: 9%;
    border-radius: 9999px;
    cursor: pointer;
    transition: outline 0.15s, background 0.15s;
  }

  .event-popup__register:hover,
  .event-popup__register:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.9);
    outline-offset: 2px;
    background: rgba(255, 255, 255, 0.12);
  }

  :global(body.event-popup-open) {
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
