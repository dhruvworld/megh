---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { reader } from '../lib/reader';
import { mediaUrl, optimizedImageSrc, optimizedImageSrcSet } from '../lib/assets';

const site = await reader.singletons.site.readOrThrow({ resolveLinkedFiles: true });
const programsRaw = await reader.collections.programs.all({ resolveLinkedFiles: true });
const programs = programsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .filter((p) => p.featuredOnHome)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

const testimonialsRaw = await reader.collections.testimonials.all({ resolveLinkedFiles: true });
const testimonials = testimonialsRaw
  .map((t) => ({ slug: t.slug, ...t.entry }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

const postsRaw = await reader.collections.posts.all({ resolveLinkedFiles: true });
const posts = postsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .sort((a, b) => String(b.publishDate ?? '').localeCompare(String(a.publishDate ?? '')))
  .slice(0, 3);

const heroImg = mediaUrl(site.heroImage ?? undefined);
const fmt = (n: number | undefined) => (n != null ? n.toLocaleString('en-IN') : '—');
---

<BaseLayout title={`${site.siteName} — Youth opportunity & CSR in India`}>
  <Header site={site} />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-brand-900/[0.06] bg-sand-50">
      <div class="pointer-events-none absolute inset-0 pattern-dots opacity-[0.35]" aria-hidden="true" />
      <div class="pointer-events-none absolute -right-40 top-20 h-[520px] w-[520px] rounded-full bg-teal-500/[0.12] blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-brand-800/[0.08] blur-3xl" aria-hidden="true" />

      <div class="container-site relative grid min-h-[min(88vh,52rem)] items-center gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-20">
        <div class="animate-rise lg:col-span-5 lg:pr-4">
          <p class="eyebrow">{site.homeHeroEyebrow ?? "India · Youth · SUSTAINABILITY"}</p>
          <h1 class="mt-5 font-display text-[2.35rem] font-semibold leading-[1.12] tracking-tight text-brand-950 sm:text-5xl lg:text-[3.25rem] lg:leading-[1.08]">
            {site.heroHeadline}
          </h1>
          <p class="animate-rise animate-rise-delay-1 mt-6 max-w-xl text-lg leading-relaxed text-brand-950/75 sm:text-xl">
            {site.heroSub}
          </p>
          <div class="animate-rise animate-rise-delay-2 mt-10 flex flex-wrap items-center gap-3">
            <a href={site.heroCtaPrimaryHref} class="btn-primary">{site.heroCtaPrimaryLabel}</a>
            <a href={site.heroCtaSecondaryHref} class="btn-secondary">{site.heroCtaSecondaryLabel}</a>
          </div>
          <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-brand-900/10 pt-10 sm:max-w-lg sm:grid-cols-3">
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-muted">{site.homeStat1Label ?? "Reach"}</dt>
              <dd class="mt-1 font-display text-2xl font-semibold text-brand-900">{fmt(site.statStudents)}</dd>
              <dd class="text-[12px] text-muted">{site.homeStat1Sub ?? "learners supported"}</dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-muted">{site.homeStat2Label ?? "Volunteers"}</dt>
              <dd class="mt-1 font-display text-2xl font-semibold text-brand-900">{fmt(site.statVolunteers)}</dd>
              <dd class="text-[12px] text-muted">{site.homeStat2Sub ?? "active contributors"}</dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-muted">{site.homeStat3Label ?? "Placements"}</dt>
              <dd class="mt-1 font-display text-2xl font-semibold text-brand-900">{fmt(site.statEmployment)}</dd>
              <dd class="text-[12px] text-muted">{site.homeStat3Sub ?? "tracked outcomes"}</dd>
            </div>
          </dl>
        </div>

        <div class="relative lg:col-span-7">
          <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-brand-900/[0.08] bg-sand-200 shadow-[0_32px_80px_-40px_rgba(15,23,42,0.35)] lg:aspect-[5/4] lg:rounded-l-3xl lg:rounded-r-2xl">
            {
              heroImg ? (
                <>
                  <img
                    src={optimizedImageSrc(heroImg, 1400)}
                    srcset={optimizedImageSrcSet(heroImg, [640, 960, 1280, 1600])}
                    sizes="(max-width: 1024px) 100vw, 58vw"
                    alt={site.heroImageAlt ?? 'Youth participating in Megh Foundation program'}
                    class="h-full w-full object-cover"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-brand-950/50 via-transparent to-transparent" aria-hidden="true" />
                </>
              ) : (
                <div class="flex h-full w-full flex-col justify-between bg-gradient-to-br from-brand-900 via-brand-800 to-teal-700 p-8 text-white sm:p-10 lg:p-12">
                  <p class="max-w-xs text-sm font-medium uppercase tracking-[0.18em] text-white/70">{site.homeHeroFallbackKicker ?? "Photography"}</p>
                  <div>
                    <p class="font-display text-2xl font-semibold leading-snug sm:text-3xl">{site.homeHeroFallbackTitle ?? "Show the work on the ground."}</p>
                    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-white/85">
                      {site.homeHeroFallbackBody ?? "Add a hero image in the CMS — cohorts, classrooms, and community moments build instant credibility with donors and CSR teams."}
                    </p>
                  </div>
                </div>
              )
            }
          </div>
          <div
            class="absolute -bottom-5 left-6 right-6 hidden rounded-xl border border-brand-900/[0.08] bg-white/95 px-6 py-4 text-[14px] text-brand-950/80 shadow-lg backdrop-blur sm:block lg:left-10 lg:right-auto lg:max-w-md"
            role="note"
          >
            <span class="font-semibold text-brand-950">{site.homeAccountabilityTitle ?? "Accountability by design"}</span>
            — {site.homeAccountabilityBody ?? "Baseline & endline reporting, budgets you can trace, and youth voice in the data."}
          </div>
        </div>
      </div>

      <div class="border-t border-brand-900/[0.06] bg-white/60 backdrop-blur-sm">
        <div class="container-site flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5 text-[13px] font-medium uppercase tracking-[0.16em] text-brand-950/45">
          <span>{site.homeTrustStrip?.[0] ?? "CSR aligned"}</span>
          <span class="hidden text-brand-900/20 sm:inline" aria-hidden="true">·</span>
          <span>{site.homeTrustStrip?.[1] ?? "Youth-led delivery"}</span>
          <span class="hidden text-brand-900/20 sm:inline" aria-hidden="true">·</span>
          <span>{site.homeTrustStrip?.[2] ?? "Rural & underserved focus"}</span>
        </div>
      </div>
    </section>

    <!-- Narrative pair -->
    <section class="section-y border-b border-brand-900/[0.06] bg-white">
      <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
        <article class="relative pl-6 before:absolute before:left-0 before:top-1 before:h-[calc(100%-0.25rem)] before:w-1 before:rounded-full before:bg-gradient-to-b before:from-teal-500 before:to-brand-800">
          <p class="eyebrow">{site.homeApproachEyebrow ?? "Approach"}</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-[2rem]">{site.youthTagline}</h2>
          <p class="mt-5 text-lg leading-relaxed text-brand-950/75">{site.youthBody}</p>
        </article>
        <article class="card pattern-dots">
          <p class="eyebrow">{site.homeOutcomesEyebrow ?? "Outcomes"}</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-[2rem]">{site.transformTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-brand-950/75">{site.transformBody}</p>
          <a href={site.transformCtaHref} class="btn-secondary mt-8 inline-flex"> {site.transformCtaLabel} </a>
        </article>
      </div>
    </section>

    <!-- Inclusivity -->
    <section class="section-y bg-brand-950 text-sand-100">
      <div class="container-site max-w-4xl">
        <p class="eyebrow text-teal-400/90">{site.homeMissionEyebrow ?? "Mission lens"}</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
          {site.inclusivityTitle}
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-sand-100/78 sm:text-xl">{site.inclusivityBody}</p>
      </div>
    </section>

    <!-- Pillars -->
    <section class="section-y border-b border-brand-900/[0.06] bg-sand-50">
      <div class="container-site">
        <div class="max-w-3xl">
          <p class="eyebrow">{site.homeFocusEyebrow ?? "Focus areas"}</p>
          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.pillarsIntroTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-brand-950/75">{site.pillarsIntroBody}</p>
        </div>
        <div class="mt-14 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
          {
            site.pillars?.map((pillar: { title: string; body: string }) => (
              <article class="group card card-hover flex flex-col border-brand-900/[0.06] !p-6 sm:!p-7">
                <h3 class="font-display text-lg font-semibold leading-snug text-brand-950">{pillar.title}</h3>
                <p class="mt-3 flex-1 text-[15px] leading-relaxed text-brand-950/72">{pillar.body}</p>
                <a href="/programs" class="link-inline mt-6 text-[14px]">
                  {site.homePillarCta ?? "Explore programs"}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Impact bento -->
    <section class="section-y bg-white">
      <div class="container-site">
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div>
            <p class="eyebrow">{site.homeEvidenceEyebrow ?? "Evidence"}</p>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeEvidenceTitle ?? "Impact at a glance"}</h2>
            <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-muted">
              {site.homeEvidenceIntro ?? "Figures are maintained in your CMS and can be tied to audit-ready reporting for CSR partners."}
            </p>
          </div>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card flex flex-col justify-between border-brand-900/[0.06] bg-gradient-to-br from-brand-900 to-brand-800 !p-8 text-white sm:col-span-2 lg:col-span-2 lg:row-span-1">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/55">{site.homeImpactLearnersLabel ?? "Learners"}</p>
              <p class="mt-3 font-display text-5xl font-semibold tracking-tight sm:text-6xl">{fmt(site.statStudents)}</p>
            </div>
            <p class="mt-6 max-w-sm text-[15px] leading-relaxed text-white/75">
              {site.homeImpactLearnersBody ?? "Training hours, assessments, and placement support — reported with context, not vanity metrics."}
            </p>
          </div>
          <div class="card flex flex-col justify-between !p-7">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeImpactVolunteersLabel ?? "Volunteers"}</p>
            <p class="mt-3 font-display text-4xl font-semibold text-brand-900">{fmt(site.statVolunteers)}</p>
            <p class="mt-4 text-[14px] leading-relaxed text-muted">{site.homeImpactVolunteersBody ?? "Mentors, facilitators, and community anchors."}</p>
          </div>
          <div class="card flex flex-col justify-between !p-7">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeImpactCampaignsLabel ?? "Campaigns"}</p>
            <p class="mt-3 font-display text-4xl font-semibold text-brand-900">{fmt(site.statCampaigns)}</p>
            <p class="mt-4 text-[14px] leading-relaxed text-muted">{site.homeImpactCampaignsBody ?? "Awareness, health, and digital inclusion drives."}</p>
          </div>
          <div class="card flex flex-col justify-between !p-7 sm:col-span-2 lg:col-span-2">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeImpactEmploymentLabel ?? "Employment & placements"}</p>
            <p class="mt-3 font-display text-4xl font-semibold text-brand-900 sm:text-5xl">{fmt(site.statEmployment)}</p>
            <p class="mt-4 max-w-xl text-[14px] leading-relaxed text-muted">
              {site.homeImpactEmploymentBody ?? "First jobs, better roles, and verified transitions — tracked responsibly for partners and participants."}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CSR -->
    <section class="section-y border-y border-brand-900/[0.06] bg-sand-100/80">
      <div class="container-site">
        <div class="max-w-3xl">
          <p class="eyebrow">{site.homePartnershipsEyebrow ?? "Partnerships"}</p>
          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.csrTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-brand-950/75">{site.csrLead}</p>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          <article class="card border-t-4 border-t-teal-500 !pt-7">
            <h3 class="font-display text-xl font-semibold text-brand-950">{site.csrPoint1Title}</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-brand-950/72">{site.csrPoint1Body}</p>
          </article>
          <article class="card border-t-4 border-t-brand-800 !pt-7">
            <h3 class="font-display text-xl font-semibold text-brand-950">{site.csrPoint2Title}</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-brand-950/72">{site.csrPoint2Body}</p>
          </article>
          <article class="card border-t-4 border-t-accent !pt-7">
            <h3 class="font-display text-xl font-semibold text-brand-950">{site.csrPoint3Title}</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-brand-950/72">{site.csrPoint3Body}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Programs -->
    <section class="section-y bg-white">
      <div class="container-site">
        <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <p class="eyebrow">{site.homeProgramsEyebrow ?? "Programmes"}</p>
            <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeProgramsTitle ?? "Where resources become capability"}</h2>
            <p class="mt-4 text-lg leading-relaxed text-brand-950/75">
              {site.homeProgramsIntro ?? "Each programme has its own narrative, gallery, and long-form detail — structured the way international NGOs present thematic work."}
            </p>
          </div>
          <a href="/programs" class="btn-secondary shrink-0"> {site.homeProgramsAllLabel ?? "View all programmes"} </a>
        </div>
        <div class="mt-14 grid gap-8 lg:grid-cols-2">
          {
            programs.map((prog) => {
              const cover = mediaUrl(prog.coverImage ?? undefined);
              return (
                <a
                  href={`/programs/${prog.slug}`}
                  class="group card card-hover flex flex-col overflow-hidden !p-0 sm:flex-row"
                >
                  <div class="relative aspect-[16/10] w-full shrink-0 bg-sand-200 sm:aspect-auto sm:h-auto sm:w-[42%] sm:min-h-[220px]">
                    {cover ? (
                      <img
                        src={optimizedImageSrc(cover, 860)}
                        srcset={optimizedImageSrcSet(cover, [420, 640, 860, 1100])}
                        sizes="(max-width: 640px) 94vw, (max-width: 1024px) 44vw, 36vw"
                        alt={prog.coverImageAlt ?? `${prog.title} cover photo`}
                        class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="absolute inset-0 bg-gradient-to-br from-brand-900 to-teal-700 opacity-90" />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/40 to-transparent sm:bg-gradient-to-r" aria-hidden="true" />
                  </div>
                  <div class="flex flex-1 flex-col p-7 sm:p-8">
                    <h3 class="font-display text-xl font-semibold leading-snug text-brand-950 group-hover:text-brand-800">{prog.title}</h3>
                    <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-brand-950/72">{prog.summary}</p>
                    <span class="link-inline mt-auto pt-6 text-[14px]">{site.homeProgramsCardCta ?? "Read programme brief"}</span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Empowerment -->
    <section class="section-y border-t border-brand-900/[0.06] bg-sand-50">
      <div class="container-site">
        <p class="eyebrow">{site.homeEmpowermentEyebrow ?? "Theory of change"}</p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeEmpowermentTitle ?? "What youth empowerment means here"}</h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            site.empowermentBlocks?.map((b: { kicker: string; title: string; body: string }) => (
              <article class="card border-brand-900/[0.06] !p-7">
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-700">{b.kicker}</p>
                <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-brand-950">{b.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-brand-950/72">{b.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="section-y bg-white">
      <div class="container-site">
        <p class="eyebrow">{site.homeVoicesEyebrow ?? "Voices"}</p>
        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeVoicesTitle ?? "From participants & volunteers"}</h2>
        <div class="mt-14 grid gap-8 lg:grid-cols-3">
          {
            testimonials.map((t) => {
              const headshot = mediaUrl(t.photo ?? undefined);
              return (
                <figure class="card card-hover flex h-full flex-col !p-8">
                  <blockquote class="flex-1">
                    <span class="quote-mark" aria-hidden="true">
                      “
                    </span>
                    <p class="mt-2 font-display text-[1.05rem] font-normal leading-relaxed text-brand-950/88 sm:text-lg">{t.quote}</p>
                  </blockquote>
                  <figcaption class="mt-8 flex items-center gap-4 border-t border-brand-900/10 pt-6">
                    {headshot ? (
                      <img
                        src={optimizedImageSrc(headshot, 112)}
                        srcset={optimizedImageSrcSet(headshot, [56, 84, 112])}
                        sizes="56px"
                        alt={t.photoAlt ?? `Portrait of ${t.name}`}
                        class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-white shadow-md"
                        width="56"
                        height="56"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div
                        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-900/10 text-sm font-semibold text-brand-800"
                        aria-hidden="true"
                      >
                        {t.name
                          .split(' ')
                          .map((w: string) => w[0])
                          .join('')
                          .slice(0, 2)
                          .toUpperCase()}
                      </div>
                    )}
                    <div>
                      <p class="font-semibold text-brand-950">{t.name}</p>
                      <p class="mt-0.5 text-[13px] text-muted">{t.role}</p>
                    </div>
                  </figcaption>
                </figure>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-y border-y border-brand-900/[0.06] bg-sand-50">
      <div class="container-site max-w-3xl">
        <p class="eyebrow">{site.homeQuestionsEyebrow ?? "Questions"}</p>
        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeQuestionsTitle ?? "Frequently asked"}</h2>
        <div class="mt-10 divide-y divide-brand-900/[0.08] rounded-2xl border border-brand-900/[0.08] bg-white shadow-sm">
          {
            site.faqs?.map((faq: { question: string; answer: string }) => (
              <details class="group px-6 py-5 first:rounded-t-2xl last:rounded-b-2xl">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left font-semibold text-brand-950 marker:content-none [&::-webkit-details-marker]:hidden">
                  <span class="text-[15px] leading-snug">{faq.question}</span>
                  <span
                    class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand-900/10 text-lg leading-none text-brand-800 transition group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </span>
                </summary>
                <p class="mt-4 pb-1 text-[15px] leading-relaxed text-brand-950/75">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Blog -->
    <section class="section-y bg-white">
      <div class="container-site">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow">{site.homeUpdatesEyebrow ?? "Updates"}</p>
            <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeUpdatesTitle ?? "Latest from the field"}</h2>
          </div>
          <a href="/blog" class="link-inline text-[15px]">
            {site.homeUpdatesAllLabel ?? "View all stories"}
          </a>
        </div>
        <ul class="mt-12 grid gap-8 md:grid-cols-3">
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`} class="group card card-hover block !p-0">
                  <div class="aspect-[16/10] overflow-hidden rounded-t-xl bg-sand-200">
                    {post.coverImage ? (
                      <img
                        src={optimizedImageSrc(mediaUrl(post.coverImage) ?? '', 640)}
                        srcset={optimizedImageSrcSet(mediaUrl(post.coverImage) ?? '', [360, 520, 640, 860])}
                        sizes="(max-width: 768px) 94vw, 30vw"
                        alt={post.coverImageAlt ?? `${post.title} cover image`}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-gradient-to-br from-brand-900/85 to-teal-700/80 text-[13px] font-medium text-white/90">
                        Story
                      </div>
                    )}
                  </div>
                  <div class="p-6">
                    <time class="text-[12px] font-semibold uppercase tracking-wider text-muted" datetime={String(post.publishDate)}>
                      {post.publishDate}
                    </time>
                    <p class="mt-2 font-display text-lg font-semibold leading-snug text-brand-950 group-hover:text-brand-800">{post.title}</p>
                    <p class="mt-2 line-clamp-3 text-[14px] leading-relaxed text-brand-950/70">{post.excerpt}</p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Governance & transparency -->
    <section class="section-y border-t border-brand-900/[0.06] bg-sand-50">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
          <div class="lg:col-span-5">
            <p class="eyebrow">{site.homeGovernanceEyebrow ?? "Governance"}</p>
            <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{site.homeGovernanceTitle ?? "Built for serious partnerships"}</h2>
            <p class="mt-5 text-lg leading-relaxed text-brand-950/75">
              {site.homeGovernanceIntro ?? "We structure delivery and reporting for institutional confidence: clear baselines, transparent budgets, participant-level progress tracking, and auditable outcomes."}
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
            <article class="card !p-7">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeComplianceLabel ?? "Compliance"}</p>
              <h3 class="mt-3 font-display text-xl font-semibold">{site.homeComplianceTitle ?? "Financial transparency"}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-brand-950/72">{site.homeComplianceBody ?? "Line-item budgets, utilization tracking, and donor-ready reporting cadence."}</p>
            </article>
            <article class="card !p-7">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeSafeguardingLabel ?? "Safeguarding"}</p>
              <h3 class="mt-3 font-display text-xl font-semibold">{site.homeSafeguardingTitle ?? "Youth-first programme design"}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-brand-950/72">{site.homeSafeguardingBody ?? "Structured mentoring, participant dignity, and safe learning environments across cohorts."}</p>
            </article>
            <article class="card !p-7 sm:col-span-2">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">{site.homeWorkflowLabel ?? "Partnership workflow"}</p>
              <ol class="mt-4 grid gap-3 text-[15px] leading-relaxed text-brand-950/76 sm:grid-cols-3">
                <li>{site.homeWorkflowStep1 ?? "01 Discovery: geography, job roles, and youth segment alignment."}</li>
                <li>{site.homeWorkflowStep2 ?? "02 Design: co-created curriculum, budget, and measurable KPI framework."}</li>
                <li>{site.homeWorkflowStep3 ?? "03 Delivery: implementation with baseline-endline evidence reporting."}</li>
              </ol>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="relative overflow-hidden border-t border-brand-900/10 bg-brand-900 py-24 text-white">
      <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
        <div class="absolute -right-20 top-0 h-96 w-96 rounded-full bg-teal-400 blur-3xl" />
        <div class="absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-white blur-3xl" />
      </div>
      <div class="container-site relative max-w-3xl text-center">
        <p class="eyebrow text-teal-200/90">{site.homeFinalEyebrow ?? "Partners & donors"}</p>
        <h2 class="mt-5 font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{site.partnerTitle}</h2>
        <p class="mt-6 text-lg leading-relaxed text-white/85">{site.partnerBody}</p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href="/contact" class="btn-primary bg-white text-brand-950 hover:bg-sand-100"> {site.homeFinalPrimaryLabel ?? "Schedule a conversation"} </a>
          <button type="button" class="btn-secondary border-white/25 bg-transparent text-white hover:border-white/40 hover:bg-white/10" data-open-volunteer-modal>
            {site.homeFinalVolunteerLabel ?? "Volunteer With Us"}
          </button>
          <a
            href={`tel:${site.phone.replace(/\s/g, '')}`}
            class="btn-secondary border-white/25 bg-transparent text-white hover:border-white/40 hover:bg-white/10"
          >
            {site.homeFinalCallLabel ?? "Call"} {site.phone}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer site={site} />
</BaseLayout>
